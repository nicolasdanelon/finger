<?xml version="1.0" encoding="utf-8"?>
<!-- App stateless: nada que respaldar ni transferir. Excluye todo en ambas vías. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
